{
  "name": "lofticore",
  "version": "0.1.0",
  "private": true,
  "description": "Lofticore - furniture marketplace",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev -w @lofticore/api",
    "dev:web": "npm run dev -w @lofticore/web",
    "build": "npm run build -w @lofticore/shared --if-present && npm run build -w @lofticore/api && npm run build -w @lofticore/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "prepare": "husky",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "share": "npx --yes cloudflared tunnel --url http://localhost:5173",
    "check": "npm run lint && npm run typecheck && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "esbuild": "0.25.12"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
