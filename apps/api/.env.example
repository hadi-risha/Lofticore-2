# Copy to .env and adjust. Everything here is checked at startup (src/config/env.ts),
# so a typo fails fast instead of breaking at 2am.

NODE_ENV=development
PORT=5000

# Browser origin(s) allowed to call the API, comma separated. The first one is
# used when building links in emails.
CLIENT_ORIGIN=http://localhost:5173

# docker compose gives you a replica set on localhost
MONGO_URI=mongodb://localhost:27018/lofticore?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6380

# Meilisearch (docker compose). Remove both lines to use MongoDB text search instead.
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=dev-meili-master-key-change-me

# Razorpay test mode (https://dashboard.razorpay.com/app/keys). Leave empty to hide the option.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Error tracking (optional)
SENTRY_DSN=

LOG_LEVEL=debug

# Generate your own: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Mailpit catches everything locally - read mail at http://localhost:8025
MAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="Lofticore <no-reply@lofticore.local>"

# Google sign-in. Create an OAuth client at console.cloud.google.com (free).
# Leave empty to disable the Google button on the API side.
GOOGLE_CLIENT_ID=

# Used once by: npm run seed:super-admin -w @lofticore/api
SUPER_ADMIN_EMAIL=owner@lofticore.local
SUPER_ADMIN_PASSWORD=ChangeThisNow123

# Demo UPI provider. A real gateway (Razorpay/Cashfree) replaces this with its own secret.
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret-change-me
PAYEE_VPA=lofticore@mockbank

# Optional: lets the chat assistant answer questions beyond its built-in guide.
# Create a free key at aistudio.google.com. Leave empty to use the built-in guide only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Uploaded photos and 3D models. "local" saves to a folder (development only: most free
# hosts wipe it on every deploy). "cloudinary" uses Cloudinary's free tier.
STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# UPI payments are a demo. Off in production unless you set this to true (staging, public demo).
ALLOW_DEMO_PAYMENTS=false
