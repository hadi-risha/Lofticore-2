{
  "name": "@lofticore/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed:super-admin": "tsx --env-file=.env src/scripts/seed-super-admin.ts",
    "seed:catalog": "tsx --env-file=.env src/scripts/seed-catalog.ts",
    "reset-2fa": "tsx --env-file=.env src/scripts/reset-2fa.ts",
    "dev:deliver": "tsx --env-file=.env src/scripts/dev-deliver-order.ts",
    "seed:models": "tsx --env-file=.env src/scripts/seed-models.ts",
    "test": "vitest run",
    "e2e:db": "tsx --env-file=.env src/scripts/e2e-reset.ts && tsx --env-file=.env src/scripts/seed-catalog.ts"
  },
  "dependencies": {
    "@lofticore/shared": "*",
    "@sentry/node": "^11.13.0",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.7",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "meilisearch": "^0.63.0",
    "mongoose": "^8.10.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pino": "^10.4.0",
    "pino-http": "^10.4.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.2",
    "razorpay": "^2.9.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "vitest": "^3.0.5"
  }
}
