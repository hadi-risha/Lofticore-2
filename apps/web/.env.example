# Web app settings. Copy to .env.local. Only variables starting with VITE_ reach the browser,
# so never put a secret here.

# Google sign-in: create an OAuth "Web application" client at console.cloud.google.com (free)
# and paste its client id. Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
# Optional: Sentry DSN for browser error tracking
VITE_SENTRY_DSN=
